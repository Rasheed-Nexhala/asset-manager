rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // Helper Functions
    // ============================================
    
    /**
     * Check if user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /**
     * Get user role from users collection
     * Returns the role string or null if user doesn't exist
     * Uses exists() to avoid errors when document doesn't exist (e.g. new signup)
     */
    function getUserRole() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data.role : null;
    }
    
    /**
     * Check if user is Admin
     * Role values are stored as PascalCase: 'Admin', 'StoreIncharge', 'SiteManager'
     */
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'Admin';
    }
    
    /**
     * Check if user is Super Admin (can manage all users including Admins, except themselves)
     * Set manually in Firestore: isSuperadmin: true
     */
    function isSuperAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(userPath) && get(userPath).data.isSuperadmin == true;
    }
    
    /**
     * Check if user is Store Incharge
     */
    function isStoreIncharge() {
      return isAuthenticated() && getUserRole() == 'StoreIncharge';
    }
    
    /**
     * Check if user is Site Manager
     */
    function isSiteManager() {
      return isAuthenticated() && getUserRole() == 'SiteManager';
    }
    
    /**
     * Check if user is Admin or Store Incharge
     * These roles have similar permissions for inventory management
     */
    function isAdminOrStoreIncharge() {
      return isAdmin() || isStoreIncharge();
    }
    
    /**
     * Check if user is active (not disabled)
     * Returns false if user document doesn't exist (e.g. new signup)
     */
    function isUserActive() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && get(userPath).data.isActive == true;
    }
    
    /**
     * Combined check: authenticated, active, and has required role
     */
    function hasInventoryAccess() {
      return isAuthenticated() && isUserActive() && isAdminOrStoreIncharge();
    }
    
    /**
     * Check if user is the assigned Site Manager for a site
     */
    function isAssignedSite(siteId) {
      let sitePath = /databases/$(database)/documents/sites/$(siteId);
      return exists(sitePath) && get(sitePath).data.managerId == request.auth.uid;
    }
    
    /**
     * Check if user is creating their own document for the first time (self-registration on signup).
     * Document must not exist yet, and payload must have safe defaults (Unassigned, isActive true).
     * New signups are active by default so they can use the app immediately; admins can deactivate if needed.
     */
    function isSelfRegistration(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return request.auth.uid == userId
        && !exists(userPath)
        && request.resource.data.role == 'Unassigned'
        && request.resource.data.isActive == true;
    }
    
    /**
     * Check if the update only touches token-related fields.
     * Users can update their own expoPushTokens, notificationPrefs, tokensUpdatedAt, updatedAt.
     */
    function onlyUpdatingOwnTokenFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['expoPushTokens', 'notificationPrefs', 'tokensUpdatedAt', 'updatedAt']);
    }
    
    /**
     * Check if the update is a self soft-delete (account deletion).
     * Only isDeleted, isActive, deletedAt, updatedAt are set; name, email, userId are preserved.
     */
    function onlySoftDeleteFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isDeleted', 'isActive', 'deletedAt', 'updatedAt']);
    }
    
    // ============================================
    // Existing Collections (preserve existing rules)
    // ============================================
    
    /**
     * Users collection
     * Users can read their own data; Admins can read all
     * Admins can create/delete users; Admins can update any field
     * Users can update ONLY their own token-related fields (expoPushTokens, notificationPrefs, tokensUpdatedAt, updatedAt)
     *
     * Required for inventory/items write access: document must exist with role in ['Admin','StoreIncharge']
     * and isActive == true. Missing or inactive user docs cause permission-denied on inventory operations.
     */
    match /users/{userId} {
      // Allow reading individual user documents
      allow get: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      // Allow listing/querying the entire users collection (only for Admins)
      allow list: if isAuthenticated() && isAdmin();
      // Allow Admins to create users; allow self-registration on signup (create own doc with Unassigned role)
      allow create: if isAuthenticated() && (
        (isUserActive() && isAdmin()) ||
        isSelfRegistration(userId)
      );
      // Admins can delete any user; users can delete their own account (Guideline 5.1.1(v))
      allow delete: if isAuthenticated() && (
        (isUserActive() && isAdmin()) ||
        request.auth.uid == userId
      );
      // Allow update: Admins and Super Admins can update other users; users can update own token fields or soft-delete
      // Super Admins can deactivate Admins; regular Admins cannot. Super Admins cannot update themselves.
      allow update: if isAuthenticated() && (
        (isUserActive() && (isAdmin() || isSuperAdmin()) && request.auth.uid != userId) ||
        (request.auth.uid == userId && (onlyUpdatingOwnTokenFields() || onlySoftDeleteFields()))
      ) && (
        resource.data.role != 'Admin' || request.resource.data.isActive != false || isSuperAdmin()
      );
    }
    
    /**
     * Check if the site update only clears the current user as manager (self-removal on account deletion)
     */
    function isRemovingSelfAsManager() {
      return resource.data.managerId == request.auth.uid
        && request.resource.data.managerId == null
        && request.resource.data.managerName == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['managerId', 'managerName', 'updatedAt']);
    }
    
    /**
     * Sites collection
     * All authenticated users can read sites
     * Only Admins can create, update, or delete sites
     * Exception: Users can update a site to remove themselves as manager (account deletion)
     */
    match /sites/{siteId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && isUserActive() && isAdmin();
      allow update: if isAuthenticated() && (
        (isUserActive() && isAdmin()) ||
        isRemovingSelfAsManager()
      );
    }
    
    /**
     * Purchase Orders collection
     * Admin and Store Incharge can read and write (create, update) purchase orders
     * Delete: Creator can delete own draft POs only
     */
    match /purchaseOrders/{poId} {
      allow read, create: if isAuthenticated() && isUserActive() && isAdminOrStoreIncharge();
      allow update: if isAuthenticated() && isUserActive() && isAdminOrStoreIncharge() &&
        (
          // Admin-only for approval/rejection transitions.
          (
            request.resource.data.status != resource.data.status &&
            request.resource.data.status in ['approved', 'rejected']
          )
          ? isAdmin()
          : true
        );
      allow delete: if isAuthenticated() && isUserActive() && isAdminOrStoreIncharge() &&
        resource.data.status == 'draft' && resource.data.createdBy == request.auth.uid;
    }
    
    /**
     * Vendors collection
     * Admin and Store Incharge can read and write vendors
     */
    match /vendors/{vendorId} {
      allow read, create, update: if isAuthenticated() && isUserActive() && isAdminOrStoreIncharge();
      allow delete: if false; // Preserve vendor history
    }
    
    /**
     * PO Counters collection
     * Purpose: Atomic counter for generating unique PO numbers (PO-YYYY-NNNN)
     */
    match /poCounters/{counterId} {
      allow read, write: if isAuthenticated() && isUserActive() && isAdminOrStoreIncharge();
    }
    
    // ============================================
    // Inventory Management Collections
    // ============================================
    
    /**
     * Items Collection
     * 
     * Purpose: Item master data (name, SKU, category, type, unit, minStockLevel, status, 
     * denormalized stock totals)
     * 
     * Access Rules:
     * - Read: Admin, Store Incharge, and Site Managers (Site Managers need item catalog for creating requests)
     * - Write: Admin and Store Incharge; Site Managers can update denormalized stock totals when returning items
     * - Create: Enforces SKU uniqueness via document ID (items/{sku}); prevents race duplicates
     * 
     * Add Stock (manual): Restricted to Admin only at application layer (ItemDetailScreen + adjustQuantity thunk).
     * Store Incharge can still receive POs, transfer, and manage maintenance via their dedicated flows.
     * 
     * Note: Site Managers need update access to adjust centralStoreQuantity/atSitesQuantity when
     * returning items from their site to central store.
     */
    match /items/{itemId} {
      allow read: if isAuthenticated() && isUserActive() &&
        (hasInventoryAccess() || isSiteManager());
      allow create: if hasInventoryAccess() &&
        !exists(/databases/$(database)/documents/items/$(request.resource.data.sku));
      allow update: if hasInventoryAccess() ||
        (isSiteManager() && isUserActive() && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['centralStoreQuantity', 'atSitesQuantity', 'updatedAt']));
      allow delete: if hasInventoryAccess();
    }
    
    /**
     * Inventory Collection
     * 
     * Purpose: Location-level stock (itemId, locationId, locationType, locationName, quantity)
     * 
     * Access Rules:
     * - Read: 
     *   - Admin and Store Incharge: can read all inventory (central store, sites, maintenance)
     *   - Site Manager: can read/list all inventory documents (needed for queries when returning items)
     * - Create: Admin, Store Incharge, and Site Managers (when creating store entry for returned items)
     * - Update: Admin, Store Incharge, and Site Managers (when returning items to store or from site)
     * - Delete: Admin and Store Incharge only
     * 
     * Add Stock (manual): Restricted to Admin only at application layer (ItemDetailScreen + adjustQuantity thunk).
     * Store Incharge can still receive POs, transfer, and manage maintenance via their dedicated flows.
     * 
     * Note: Site Managers need full read/list access to query inventory documents when returning items.
     * The queries filter by itemId and locationId to find the correct inventory documents to update.
     */
    match /inventory/{inventoryId} {
      allow read, list: if isAuthenticated() && isUserActive() &&
        (isAdminOrStoreIncharge() || isSiteManager());
      allow create: if hasInventoryAccess() ||
        (isSiteManager() && isUserActive() && request.resource.data.locationId == 'store' &&
         request.resource.data.keys().hasOnly(['itemId', 'itemName', 'itemSku', 'locationId', 'locationType', 'locationName', 'quantity', 'updatedAt', 'lengthPerPiece']));
      allow update: if hasInventoryAccess() ||
        (isSiteManager() && isUserActive() &&
         (
           (resource.data.locationType == 'site' && isAssignedSite(resource.data.locationId.replace('site_', '')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt'])) ||
           (resource.data.locationId == 'store' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt']))
         ));
      allow delete: if hasInventoryAccess();
    }
    
    /**
     * Steel Master Collection
     *
     * Purpose: Standard steel item specifications for KG-to-pieces conversion
     * (name, code, type, weightPerMeter, standardLengths, defaultLength, hsnCode)
     *
     * Access Rules:
     * - Read: Admin, Store Incharge, and Site Managers (for item display when creating requests)
     * - Write: Admin and Store Incharge only
     */
    match /steelMaster/{masterId} {
      allow read: if isAuthenticated() && isUserActive() &&
        (hasInventoryAccess() || isSiteManager());
      allow create, update, delete: if hasInventoryAccess();
    }

    /**
     * Categories Collection
     * 
     * Purpose: Item categories (name)
     * 
     * Access Rules:
     * - Read: Admin, Store Incharge, and Site Managers (for item display when creating requests)
     * - Write: Admin and Store Incharge only
     */
    match /categories/{categoryId} {
      allow read: if isAuthenticated() && isUserActive() &&
        (hasInventoryAccess() || isSiteManager());
      allow create: if hasInventoryAccess();
      allow update: if hasInventoryAccess();
      allow delete: if hasInventoryAccess();
    }
    
    /**
     * Maintenance Collection
     *
     * Purpose: Items sent for repair/maintenance (quantity, issueType, status, etc.)
     * Tracks items moved from central store to maintenance and their return/write-off.
     *
     * Access Rules:
     * - Read, Create, Update, Delete: Admin and Store Incharge only
     */
    match /maintenance/{maintenanceId} {
      allow read, create, update, delete: if hasInventoryAccess();
    }

    /**
     * Inventory Adjustments Collection
     * 
     * Purpose: Audit log for every quantity change
     * Fields: itemId, locationId, type (add/remove), quantityBefore/After, reason, 
     * notes, adjustedBy, createdAt
     * 
     * Access Rules:
     * - Read: Admin and Store Incharge only
     * - Create: Admin and Store Incharge only (when making adjustments)
     * - Update: Denied (adjustments are immutable audit records)
     * - Delete: Denied (adjustments are immutable audit records)
     * 
     * Note: This is an audit trail - once created, adjustments should never be modified
     * or deleted. Only Admins and Store Incharge can create adjustments when they
     * adjust inventory quantities.
     */
    match /inventoryAdjustments/{adjustmentId} {
      allow read: if hasInventoryAccess();
      allow create: if hasInventoryAccess();
      allow update: if false; // Immutable audit log
      allow delete: if false; // Immutable audit log
    }

    /**
     * Activity Logs Collection
     *
     * Purpose: Immutable audit trail of all system activities across CIAMS modules
     * (authentication, users, sites, inventory, requests, purchase orders,
     * maintenance, vendors). Logs are server-side generated via Cloud Functions
     * and cannot be modified or deleted by any client.
     *
     * Access Rules (per 08_Activity_Logging_and_Audit_Trail / Phase 1.3):
     * - Read (Admin): Full access to all logs for audit and compliance
     * - Read (User): Restricted to own logs only (userId == request.auth.uid)
     * - Write: Denied for all clients - only Cloud Functions create logs
     *
     * Immutability: create, update, delete are explicitly denied to enforce
     * tamper-proof audit trail. All writes occur server-side via Cloud Functions.
     */
    match /activityLogs/{logId} {
      // Admin can read all logs for audit purposes
      allow read: if isAuthenticated() && isUserActive() && isAdmin();

      // Users can read only their own logs (userId match)
      // Includes new signup users (Unassigned, isActive: true) for Dashboard My Recent Activity widget
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // No client writes allowed - only Cloud Functions create logs
      allow create, update, delete: if false;
    }
    
    // ============================================
    // Request Management Collections
    // ============================================
    
    /**
     * Check if user can manage requests (Store Incharge or Admin)
     */
    function canManageRequests() {
      return isAuthenticated() && isUserActive() && (isAdmin() || isStoreIncharge());
    }

    /**
     * Request Counters Collection
     *
     * Purpose: Atomic counter for generating unique request numbers (REQ-YYYY-NNNN).
     * Site Managers need read/write to increment when creating requests.
     */
    match /requestCounters/{counterId} {
      allow read, write: if isAuthenticated() && isUserActive() &&
        (isAdmin() || isStoreIncharge() || isSiteManager());
    }
    
    /**
     * Requests Collection
     * 
     * Purpose: Site Manager requests for inventory items from Central Store
     * 
     * Access Rules:
     * - Read:
     *   - Admin and Store Incharge: can read all requests
     *   - Site Manager: can only read their own requests (where requestedBy == user.uid)
     * - Create:
     *   - Site Managers: can create requests for themselves (draft or pending status)
     * - Update:
     *   - Site Managers: can ONLY edit their own DRAFT requests (before submission)
     *   - Store Incharge/Admin: can update for approval/rejection/transfer
     *     CRITICAL: Store Incharge CANNOT edit items/priority (enforced in service layer)
     * - Delete:
     *   - Admin: can delete any request
     *   - Site Manager: can delete own DRAFT requests only
     * 
     * Business Rules Enforced:
     * - No partial fulfillment (enforced in service)
     * - Store Incharge cannot edit request items/priority (enforced in service)
     * - Site Manager can only edit own draft requests (enforced here and in service)
     */
    match /requests/{requestId} {
      // Read access
      allow read: if isAuthenticated() && isUserActive() && (
        isAdmin() ||
        isStoreIncharge() ||
        (isSiteManager() && resource.data.requestedBy == request.auth.uid)
      );
      
      // Create: Only Site Managers for their own requests
      allow create: if isAuthenticated() && 
        isUserActive() &&
        isSiteManager() && 
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status in ['draft', 'pending'];
      
      // Update: Site Managers (own drafts only OR returning items on transferred/partially_returned requests),
      // Store Incharge/Admin (approve/reject/transfer only - NO edit)
      // Store Incharge can update status, processedBy, rejectionReason etc. but NOT items/priority (enforced in service)
      allow update: if isAuthenticated() && isUserActive() && (
        isAdmin() ||
        (isSiteManager() && 
         resource.data.requestedBy == request.auth.uid && (
           (resource.data.status == 'draft' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priority', 'purpose', 'items', 'status', 'updatedAt'])) ||
           (resource.data.status == 'pending' && request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
           (resource.data.status in ['transferred', 'partially_returned'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'status', 'returnHistory', 'updatedAt']))
         )
        ) ||
        (isStoreIncharge() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'processedBy', 'processedByName', 'processedAt', 'storeNotes', 
          'rejectionReason', 'rejectionComments', 'items', 'transferredAt', 'transferredBy', 
          'transferredByName', 'receivedBy', 'receivedByName', 'updatedAt'
        ]))
      );
      
      // Delete: Admin (any) or Site Manager (own draft only)
      allow delete: if isAuthenticated() && isUserActive() && (
        isAdmin() ||
        (isSiteManager() && resource.data.requestedBy == request.auth.uid && resource.data.status == 'draft')
      );
    }

    /**
     * Notifications subcollection
     * Path: notifications/{userId}/items/{itemId}
     * Users can read and update their own notification items; create/delete are server-only
     */
    match /notifications/{userId}/items/{itemId} {
      allow read, update: if isAuthenticated() && request.auth.uid == userId;
      allow create, delete: if false;
    }

    /**
     * Inventory Update Requests Collection
     *
     * Purpose: Store Incharge requests Admin approval to update (add/reduce/enter) central store inventory.
     * Admin can approve (with expiry), reject, or revoke/restore access anytime. All changes are logged.
     *
     * Access Rules:
     * - Read: Admin (all) OR Store Incharge (own requests only: resource.data.requestedBy == request.auth.uid)
     * - Create: Store Incharge only
     * - Update: Admin only (for approve/reject)
     * - Delete: false (immutable audit trail)
     */
    match /inventoryUpdateRequests/{requestId} {
      allow read: if isAuthenticated() && isUserActive() && (
        isAdmin() ||
        (isStoreIncharge() && resource.data.requestedBy == request.auth.uid)
      );
      allow create: if isAuthenticated() && isUserActive() && isStoreIncharge();
      allow update: if isAuthenticated() && isUserActive() && isAdmin();
      allow delete: if false;
    }
  }
}
