# Copy to `.env` in this directory (see asset-manager/.gitignore — `.env` is gitignored).
# When unset, `config/firebase.ts` uses embedded production defaults.
#
# Quick switch:
#   npm start              → production (or values from `.env` if present)
#   npm run start:demo     → loads `.env.demo` via dotenv-cli (demo Firebase)
# You can also copy `.env.demo` to `.env` and use `npm start` as usual.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: callable Cloud Functions region (e.g. us-central1). Omit for SDK default.
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=
