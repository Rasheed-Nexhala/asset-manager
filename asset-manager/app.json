{
  "expo": {
    "name": "Asset Manager",
    "slug": "asset-manager",
    "version": "5.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "androidMode": "default",
      "androidCollapsedTitle": "Asset Manager"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibf.assetmanager",
      "buildNumber": "9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ibf.assetmanager",
      "googleServicesFile": "./google-services.json",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Asset Manager uses your photo library to attach images to maintenance records (e.g. photos of damaged equipment), inventory items, and purchase order receipts. For example, when you add an item to maintenance, you can select photos from your device to document the damage."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "defaultChannel": "default"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "nexhala",
          "project": "react-native"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1b6e5a32-1289-48e1-a3a8-bab8fff5d5fd"
      }
    }
  }
}
