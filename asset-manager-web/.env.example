# Copy to `.env.local` or use mode-specific files (see package.json scripts).
# Production defaults are embedded in `src/config/firebase.ts` when these are unset.
#
# Quick switch:
#   npm run dev          → production project (fallbacks or `.env.production`)
#   npm run dev:demo     → loads `.env.demo` (asset-manager-demo)
#   npm run build:demo   → production bundle against demo (for demo Hosting)
#
# After deploying backend to demo: from `asset-manager/`, run:
#   npx firebase-tools@latest use demo
#   npx firebase-tools@latest deploy --only firestore,storage,functions
# Smoke-test: sign in, create a Firestore doc, trigger a callable — only in the demo project.

# Firebase Web SDK (same keys as Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: must match deployed callable Cloud Functions region (e.g. us-central1, europe-west1).
# Omit to use the JS SDK default (typically us-central1).
VITE_FIREBASE_FUNCTIONS_REGION=
